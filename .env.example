# ===========================================
# ImmoCalc Pro - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local with real values to version control!

# -----------------------------------------
# Database Configuration
# -----------------------------------------
# Database password for PostgreSQL container
DB_PASSWORD=your_secure_postgres_password_here

# PostgreSQL connection string
# Note: When using Docker Compose, the DATABASE_URL is automatically set by the compose file
# The format below is for reference and local development outside Docker
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# For Docker deployment (set automatically by docker-compose.yml)
# DATABASE_URL="postgresql://immo_user:${DB_PASSWORD}@db:5432/immo_invest?schema=public"

# For local development outside Docker (replace with your actual values)
DATABASE_URL="postgresql://user:password@localhost:5432/immo_invest?schema=public"

# For development with SQLite (alternative)
# DATABASE_URL="file:./dev.db"

# -----------------------------------------
# Authentication
# -----------------------------------------
# JWT Secret (for session management - minimum 32 characters)
# In production, this MUST be set to a secure random string
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_here_at_least_32_chars

# Secret key for session management (optional, defaults to JWT_SECRET if not set)
# Generate with: openssl rand -base64 32
# SESSION_SECRET=

# -----------------------------------------
# AI Integration (Optional)
# -----------------------------------------
# For AI-powered deal analysis and recommendations
# Get your API key from https://platform.openai.com

OPENAI_API_KEY=

# -----------------------------------------
# Maps Integration (Optional)
# -----------------------------------------
# For property location display and nearby amenities
# Get your API key from https://console.cloud.google.com

NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# -----------------------------------------
# CoachMark Debug Mode (Development/Testing)
# -----------------------------------------
# Enable debug mode to show diagnostic information in onboarding tooltips
# Useful for troubleshooting positioning and visibility issues on mobile

# NEXT_PUBLIC_COACHMARK_DEBUG=false
# NEXT_PUBLIC_COACHMARK_FORCE_FALLBACK=false

# -----------------------------------------
# Deployment (Vercel)
# -----------------------------------------
# These are automatically set by Vercel during deployment
# You don't need to set these manually

# VERCEL_URL=
# VERCEL_ENV=

# -----------------------------------------
# Notes
# -----------------------------------------
# - NEXT_PUBLIC_ prefix makes variables available in browser
# - Without NEXT_PUBLIC_ prefix, variables are server-side only
# - All features work without external APIs (graceful degradation)
